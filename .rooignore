# --- Dependency & Tooling Folders ---
# These are the largest token consumers and should always be ignored.
node_modules/
.pnpm-store/
.yarn/
.npm/

# --- SolidJS & Vite Build Outputs ---
# These contain autogenerated code that confuses the model's reasoning.
dist/
.solid/
.output/
lib/
build/
stats.html

# --- Tailwind & CSS Artifacts ---
# Prevents the model from reading thousands of lines of compiled CSS.
src/index.css
**/*.min.css
**/*.css.map
postcss.config.js
autoprefixer.config.js
# Only ignore tailwind.config.js if you use 100% default settings.
# If you have custom colors/themes, remove the line below.
tailwind.config.js

# --- Media, Assets, and Binaries ---
# Models cannot "read" these; they only waste context space.
public/assets/
**/*.png
**/*.jpg
**/*.jpeg
**/*.gif
**/*.svg
**/*.ico
**/*.mp4
**/*.pdf
**/*.woff
**/*.woff2

# --- Environment & Secrets ---
# For security and to keep the model from trying to guess keys.
.env
.env.*
!.env.example

# --- Version Control & IDE Trash ---
.git/
.svn/
.hg/
.DS_Store
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# --- Logs and Temps ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.stylelintcache